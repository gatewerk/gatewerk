# .env.example — copy to .env and fill in values, OR run scripts/quickstart.sh
# which generates a .env with cryptographically random secrets automatically.
#
# For manual setup: replace every placeholder below with real values.
# For Docker Compose eval: only the four REQUIRED vars below are needed;
# the rest enable optional features (SMTP email, cloud integrations).

# ── Required ─────────────────────────────────────────────────────────────────

# Random password for the bundled Postgres container (eval/self-host only).
# Not used when pointing DATABASE_URL at an external database.
POSTGRES_PASSWORD=replace-with-random-hex

# Full Postgres connection string. When using the eval compose (docker-compose.yml)
# this is built from POSTGRES_PASSWORD automatically; set this directly for
# external DBs. Note: when set manually the password here must match
# POSTGRES_PASSWORD above.
# The README Quick Start uses docker/docker-compose.dev.yml instead, whose
# Postgres container has a fixed dev password ("gatewerk") independent of
# POSTGRES_PASSWORD above — the default below matches that container.
DATABASE_URL=postgresql://gatewerk:gatewerk@localhost:5432/gatewerk

# JWT signing secret — min 32 random bytes (hex).
JWT_SECRET=replace-with-random-hex-64-chars

# HMAC signing secret for webhook signatures — min 32 random bytes (hex).
HMAC_SECRET=replace-with-random-hex-64-chars

# HMAC secret for email OTP codes — min 32 random bytes (hex).
OTP_HMAC_SECRET=replace-with-random-hex-64-chars

# Encrypts stored authenticator (TOTP) secrets at rest — exactly 64 hex chars
# (32 bytes). Without it, two-factor enrolment is unavailable.
TOTP_ENCRYPTION_KEY=replace-with-random-hex-64-chars

# Origin of the web dashboard. Used for CORS and redirect validation.
UI_ORIGIN=http://localhost:8880

# ── Optional / defaults ───────────────────────────────────────────────────────

PORT=3100
NODE_ENV=production
GATEWERK_MODE=standalone
UPLOADS_DIR=/data/uploads

# VITE build args (web container only) — defaults work for local eval.
VITE_API_URL=http://localhost:3100

# ── SMTP email transport (optional) ──────────────────────────────────────────
# Absence triggers graceful no-email mode (audit log shows email.send_skipped_no_config).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=
# Address a human reads: used for Reply-To and the List-Unsubscribe mailto.
# Leave blank to send with no Reply-To.
EMAIL_CONTACT_ADDRESS=noreply@example.com

# ── Slack per-user DMs (optional) ────────────────────────────────────────────
# Absence is graceful: the Slack routes answer "Slack not configured" and every
# other channel keeps working. Self-host operators register their OWN Slack app,
# the same bring-your-own posture as SMTP.
#
# Setup:
#   1. Create an app at https://api.slack.com/apps (From an app manifest is fastest).
#   2. Bot token scopes: chat:write, users:read, users:read.email
#      (users:read.email is an extension of users:read, so both are required.)
#   3. Leave token rotation OFF. Gatewerk stores one long lived bot token.
#   4. Redirect URL: exactly ${API_ORIGIN}/api/v1/slack/callback
#   5. Generate the encryption key with: openssl rand -hex 32
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Encrypts the workspace bot token at rest. Exactly 64 hex characters.
# Losing or changing it means every connected workspace must reconnect.
# SLACK_TOKEN_ENCRYPTION_KEY=

# Public origin of this API. The Slack OAuth redirect is built from it and must
# match a redirect URL registered in the Slack app character for character.
# Only needed when the API and the UI are on different origins; falls back to
# UI_ORIGIN otherwise.
# API_ORIGIN=https://api.example.com
