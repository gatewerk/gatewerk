# Public build-time configuration — committed on purpose.
# These values are public by definition: they are baked into the served HTML.
# (The Turnstile SECRET key lives in the Cloudflare Pages dashboard for the
# /api/waitlist function; real secrets never go in this file.)
# Vite loads this for `astro build` (production mode) identically in CI and
# locally — no CI env passthrough needed.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD3QrtJAj874Apl2
PUBLIC_CAL_LINK=https://cal.com/gatewerk/letstalk
