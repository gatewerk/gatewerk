---
import { QUIET_MODE } from "../quiet-mode";
if (QUIET_MODE) return Astro.redirect("/");
import MarketingLayout from "../layouts/MarketingLayout.astro";
const calLink = import.meta.env.PUBLIC_CAL_LINK ?? "https://cal.com/gatewerk/letstalk";
---

<MarketingLayout
  title="Pricing · Gatewerk"
  description="Self host free forever. Managed cloud: Solo $6/mo with a 30 day free trial. Team and Business coming soon."
>

  <!-- ─── ambient glow ─── -->
  <div style="position:absolute;top:-260px;left:50%;transform:translateX(-50%);width:1100px;height:600px;background:radial-gradient(ellipse at center,rgba(33,181,113,.13),transparent 68%);pointer-events:none;filter:blur(20px);z-index:0;"></div>

  <!-- ─── Hero ─── -->
  <section style="position:relative;z-index:1;max-width:900px;margin:0 auto;padding:84px 32px 20px;text-align:center;">
    <div class="gw-up gw-mono" style="font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#26c87d;">Pricing</div>
    <h1 class="gw-up gw-display" style="font-weight:600;font-size:clamp(34px,5vw,58px);line-height:1.04;letter-spacing:-.03em;color:#f7f7f1;margin:16px auto 0;max-width:16ch;text-wrap:balance;">Start free. Self host runs everything.</h1>
    <p class="gw-up" style="max-width:560px;margin:22px auto 0;font-size:17px;line-height:1.6;color:#b4b4ac;text-wrap:pretty;">The full product is free forever on your own infrastructure. Managed cloud tiers add hosting, seats, and support when you want us to run it.</p>
  </section>

  <!-- ─── Billing toggle + Cards ─── -->
  <section style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:40px 32px 0;">

    <!-- toggle -->
    <div style="display:flex;justify-content:center;margin:0 0 32px;">
      <div style="display:inline-flex;align-items:center;gap:4px;padding:4px;border-radius:999px;border:1px solid rgba(240,240,220,.1);background:rgba(240,240,220,.045);-webkit-backdrop-filter:blur(10px) saturate(140%);backdrop-filter:blur(10px) saturate(140%);box-shadow:inset 0 1px 0 rgba(240,240,220,.06);">
        <button
          id="btn-monthly"
          type="button"
          aria-pressed="true"
          style="height:34px;padding:0 15px;border:none;border-radius:999px;font-family:'Hanken Grotesk',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;transition:all .15s;background:rgba(240,240,220,.1);color:#f7f7f1;box-shadow:0 1px 2px rgba(0,0,0,.3);"
        >Monthly</button>
        <button
          id="btn-annual"
          type="button"
          aria-pressed="false"
          style="height:34px;padding:0 15px;border:none;border-radius:999px;font-family:'Hanken Grotesk',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;transition:all .15s;background:transparent;color:#9a9a8f;"
        >Annual</button>
      </div>
    </div>

    <!-- 4 cards grid -->
    <div class="gw-pricing-cards">

      <!-- Self Host -->
      <div style="display:flex;flex-direction:column;border:1px solid rgba(33,181,113,.32);border-radius:16px;background:linear-gradient(180deg,rgba(33,181,113,.08),transparent);padding:26px 24px;">
        <div class="gw-mono" style="font-size:11px;font-weight:600;letter-spacing:.06em;color:#26c87d;">SELF HOST</div>
        <div class="gw-display" style="font-size:26px;font-weight:700;color:#f7f7f1;margin:12px 0 0;">Free forever</div>
        <div style="min-height:15px;margin:6px 0 0;"></div>
        <p style="font-size:13.5px;line-height:1.55;color:#9a9a8f;margin:10px 0 18px;">Run the full product on your own infrastructure. Every feature, no limits.</p>
        <div style="display:flex;flex-direction:column;gap:9px;flex:1;">
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Every feature, no limits</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Unlimited reviewers &amp; reviews</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Full tamper evident audit log</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Community support &middot; AGPL-3.0</div>
        </div>
        <a href="/docs/quickstart" style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:22px;height:42px;border-radius:10px;background:#21b571;color:#0e1a12;font-size:14px;font-weight:600;transition:background .15s;text-decoration:none;" onmouseover="this.style.background='#26c87d'" onmouseout="this.style.background='#21b571'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          Read the quickstart
        </a>
      </div>

      <!-- Solo -->
      <div style="display:flex;flex-direction:column;border:1px solid rgba(240,240,220,.08);border-radius:16px;background:#1c1c1a;padding:26px 24px;">
        <div class="gw-mono" style="font-size:11px;font-weight:600;letter-spacing:.06em;color:#8f887c;">SOLO</div>
        <div class="gw-display" style="font-size:26px;font-weight:700;color:#f7f7f1;margin:12px 0 0;">
          <span id="solo-price">$6</span><span class="gw-mono" style="font-size:15px;font-weight:500;color:#8f887c;" id="solo-unit">/mo</span>
        </div>
        <div class="gw-mono" style="font-size:11.5px;color:#7b7b72;margin:6px 0 0;min-height:15px;" id="solo-sub"></div>
        <p style="font-size:13.5px;line-height:1.55;color:#9a9a8f;margin:10px 0 18px;">Managed hosting for one person. 30 day trial, no card required.</p>
        <div style="display:flex;flex-direction:column;gap:9px;flex:1;">
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Fully managed hosting</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>1 reviewer seat</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Email &amp; webhook delivery</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>90 day audit retention</div>
        </div>
        <a href="https://app.gatewerk.com/signup" style="display:flex;align-items:center;justify-content:center;margin-top:22px;height:42px;border-radius:10px;border:1px solid rgba(240,240,220,.14);color:#e4e0d6;font-size:14px;font-weight:600;transition:background .15s,border-color .15s;text-decoration:none;" onmouseover="this.style.background='rgba(240,240,220,.05)';this.style.borderColor='rgba(240,240,220,.24)'" onmouseout="this.style.background='';this.style.borderColor='rgba(240,240,220,.14)'">Start free trial</a>
      </div>

      <!-- Team -->
      <div style="display:flex;flex-direction:column;border:1px solid rgba(240,240,220,.08);border-radius:16px;background:#1c1c1a;padding:26px 24px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0;">
          <div class="gw-mono" style="font-size:11px;font-weight:600;letter-spacing:.06em;color:#8f887c;">TEAM</div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:.07em;padding:3px 7px;border-radius:999px;background:rgba(240,240,220,.06);border:1px solid rgba(240,240,220,.1);color:#8f887c;">Coming soon</span>
        </div>
        <div class="gw-display" style="font-size:26px;font-weight:700;color:#f7f7f1;margin:12px 0 0;">
          <span id="team-price">$49</span><span class="gw-mono" style="font-size:15px;font-weight:500;color:#8f887c;" id="team-unit">/mo</span>
        </div>
        <div class="gw-mono" style="font-size:11.5px;color:#7b7b72;margin:6px 0 0;min-height:15px;" id="team-sub"></div>
        <p style="font-size:13.5px;line-height:1.55;color:#9a9a8f;margin:10px 0 18px;">For teams shipping together. 30 day trial included.</p>
        <div style="display:flex;flex-direction:column;gap:9px;flex:1;">
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#e4e0d6;font-weight:500;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Everything in Solo, plus:</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Up to 5 seats</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Shared review queues</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Feedback memory &middot; priority support</div> <!-- audit-claims-allow: coming-soon Team tier promise, waitlisted not purchasable -->
        </div>
        <a href="/waitlist?tier=team" style="display:flex;align-items:center;justify-content:center;margin-top:22px;height:42px;border-radius:10px;border:1px solid rgba(240,240,220,.14);color:#e4e0d6;font-size:14px;font-weight:600;transition:background .15s,border-color .15s;text-decoration:none;" onmouseover="this.style.background='rgba(240,240,220,.05)';this.style.borderColor='rgba(240,240,220,.24)'" onmouseout="this.style.background='';this.style.borderColor='rgba(240,240,220,.14)'">Join the waitlist</a>
      </div>

      <!-- Business -->
      <div style="display:flex;flex-direction:column;border:1px solid rgba(240,240,220,.08);border-radius:16px;background:#1c1c1a;padding:26px 24px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0;">
          <div class="gw-mono" style="font-size:11px;font-weight:600;letter-spacing:.06em;color:#8f887c;">BUSINESS</div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:9.5px;font-weight:600;letter-spacing:.07em;padding:3px 7px;border-radius:999px;background:rgba(240,240,220,.06);border:1px solid rgba(240,240,220,.1);color:#8f887c;">Coming soon</span>
        </div>
        <div class="gw-display" style="font-size:26px;font-weight:700;color:#f7f7f1;margin:12px 0 0;">Let's talk</div>
        <div style="min-height:15px;margin:6px 0 0;"></div>
        <p style="font-size:13.5px;line-height:1.55;color:#9a9a8f;margin:10px 0 18px;">Custom SMTP, managed webhook routing, and an SLA.</p>
        <div style="display:flex;flex-direction:column;gap:9px;flex:1;">
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#e4e0d6;font-weight:500;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Everything in Team, plus:</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Custom SMTP &amp; webhook routing</div>
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>SSO &amp; 99.9% uptime SLA</div> <!-- audit-claims-allow: coming-soon Business tier promise, waitlisted not purchasable -->
          <div style="display:flex;align-items:flex-start;gap:9px;font-size:13px;line-height:1.4;color:#cfcfc5;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7b7b72" stroke-width="2.4" style="flex-shrink:0;margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>Dedicated support</div> <!-- audit-claims-allow: coming-soon Business tier promise, waitlisted not purchasable -->
        </div>
        <a href={calLink} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;margin-top:22px;height:42px;border-radius:10px;border:1px solid rgba(240,240,220,.14);color:#e4e0d6;font-size:14px;font-weight:600;transition:background .15s,border-color .15s;text-decoration:none;" onmouseover="this.style.background='rgba(240,240,220,.05)';this.style.borderColor='rgba(240,240,220,.24)'" onmouseout="this.style.background='';this.style.borderColor='rgba(240,240,220,.14)'">Talk to the founder</a>
      </div>

    </div>

    <!-- honest line -->
    <div style="text-align:center;margin:26px 0 0;">
      <p class="gw-mono" style="font-size:12px;color:#7b7b72;margin:0;">All cloud tiers include the full open source feature set.</p>
      <p class="gw-mono" style="font-size:12px;color:#7b7b72;margin:6px 0 0;">Solo and self host are live today. Team and Business open after launch.</p>
    </div>
  </section>

  <!-- ─── Comparison table ─── -->
  <section style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:72px 32px 0;">
    <h2 class="gw-display" style="font-size:clamp(24px,3vw,34px);font-weight:600;letter-spacing:-.02em;color:#f7f7f1;margin:0 0 28px;">Compare every plan</h2>
    <div class="gw-cmp-scroll" style="border:1px solid rgba(240,240,220,.08);border-radius:16px;overflow:hidden;">
      <div style="min-width:560px;">
      <!-- header row -->
      <div class="gw-cmp-header">
        <div style="padding:16px 20px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;color:#8f887c;">CAPABILITY</div>
        <div style="padding:16px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:#26c87d;text-align:center;">SELF HOST</div>
        <div style="padding:16px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:#8f887c;text-align:center;">SOLO</div>
        <div style="padding:16px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:#8f887c;text-align:center;">TEAM</div>
        <div style="padding:16px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:#8f887c;text-align:center;">BUSINESS</div>
      </div>
      <!-- price row (toggle-aware) -->
      <div id="cmp-price-row" class="gw-cmp-row" style="border-bottom:1px solid rgba(240,240,220,.05);">
        <div style="padding:15px 20px;font-size:14px;color:#e4e0d6;">Price</div>
        <div style="padding:15px 14px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:13px;color:#9a9a8f;">Free</div>
        <div style="padding:15px 14px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:13px;color:#9a9a8f;" id="cmp-solo-price">$6/mo</div>
        <div style="padding:15px 14px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:13px;color:#9a9a8f;" id="cmp-team-price">$49/mo</div>
        <div style="padding:15px 14px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:13px;color:#9a9a8f;">Let's talk</div>
      </div>
      <!-- static rows -->
      {[
        { label: "Hosting",               a: "Your infra",  b: "Managed",    c: "Managed",    d: "Managed",   odd: false },
        { label: "Reviewer seats",        a: "Unlimited",   b: "1",          c: "5",          d: "Custom",    odd: true  },
        { label: "Reviews per month",     a: "Unlimited",   b: "Unlimited",  c: "Unlimited",  d: "Unlimited", odd: false },
        { label: "Tamper evident audit",  a: true,          b: true,         c: true,         d: true,        odd: true  },
        { label: "Feedback memory",       a: true,          b: false,        c: true,         d: true,        odd: false },
        { label: "Shared review queues",  a: true,          b: false,        c: true,         d: true,        odd: true  },
        { label: "Custom SMTP",           a: true,          b: false,        c: false,        d: true,        odd: false },
        { label: "Uptime SLA",            a: false,         b: false,        c: false,        d: "99.9%",     odd: true  },
        { label: "Support",               a: "Community",   b: "Community",  c: "Priority",   d: "Dedicated", odd: false },
      ].map(({ label, a, b, c, d, odd }) => {
        const bg = odd ? "background:rgba(240,240,220,.015);" : "";
        function cell(v: unknown) {
          if (v === true)  return <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="2.6" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg>;
          if (v === false) return <span style="color:#4a4a44;font-size:15px;">&#215;</span>;
          return <span style="font-size:13px;color:#9a9a8f;font-family:'JetBrains Mono',monospace;">{v as string}</span>;
        }
        return (
          <div class="gw-cmp-row" style={`${bg}border-bottom:1px solid rgba(240,240,220,.05);`}>
            <div style="padding:15px 20px;font-size:14px;color:#e4e0d6;">{label}</div>
            <div style="padding:15px 14px;text-align:center;">{cell(a)}</div>
            <div style="padding:15px 14px;text-align:center;">{cell(b)}</div>
            <div style="padding:15px 14px;text-align:center;">{cell(c)}</div>
            <div style="padding:15px 14px;text-align:center;">{cell(d)}</div>
          </div>
        );
      })}
      </div>
    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section style="position:relative;z-index:1;max-width:820px;margin:0 auto;padding:80px 32px 0;">
    <h2 class="gw-display" style="font-size:clamp(24px,3vw,34px);font-weight:600;letter-spacing:-.02em;color:#f7f7f1;margin:0 0 28px;">Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(240,240,220,.08);">

      <div style="padding:24px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <h3 class="gw-display" style="font-size:17px;font-weight:600;color:#f1f1ec;margin:0 0 8px;">Is self host really the full product?</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#9a9a8f;margin:0;">Yes. Every feature, no seat limits, no feature behind a sales call. Run it under AGPL on your own infrastructure for free, forever.</p>
      </div>

      <div style="padding:24px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <h3 class="gw-display" style="font-size:17px;font-weight:600;color:#f1f1ec;margin:0 0 8px;">Do I need a card to try the cloud?</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#9a9a8f;margin:0;">No. The Solo plan includes a free 30 day trial with no card. Add billing whenever you are ready.</p>
      </div>

      <div style="padding:24px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <h3 class="gw-display" style="font-size:17px;font-weight:600;color:#f1f1ec;margin:0 0 8px;">When can I get Team or Business?</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#9a9a8f;margin:0;">Both are on the waitlist now. Join and we notify you the moment they open. Early accounts are grandfathered.</p>
      </div>

      <div style="padding:24px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <h3 class="gw-display" style="font-size:17px;font-weight:600;color:#f1f1ec;margin:0 0 8px;">Does everything work on self hosted?</h3>
        <p style="font-size:14.5px;line-height:1.6;color:#9a9a8f;margin:0;">Yes. The MCP server, TypeScript and Python SDKs, and n8n nodes all work on every tier including self hosted. Governance and audit logging are never paywalled.</p>
      </div>

    </div>

    <p style="margin-top:40px;text-align:center;font-size:13.5px;color:#8f887c;">
      Questions? <a href="mailto:hello@gatewerk.com" style="color:#26c87d;text-decoration:none;">hello@gatewerk.com</a> · solo founder, I read everything and reply within a day.
    </p>
  </section>

  <!-- ─── Billing toggle script ─── -->
  <script is:inline>
    (function () {
      var billing = 'monthly';
      var btnMonthly = document.getElementById('btn-monthly');
      var btnAnnual  = document.getElementById('btn-annual');

      // card price nodes
      var soloPrice = document.getElementById('solo-price');
      var soloUnit  = document.getElementById('solo-unit');
      var soloSub   = document.getElementById('solo-sub');
      var teamPrice = document.getElementById('team-price');
      var teamUnit  = document.getElementById('team-unit');
      var teamSub   = document.getElementById('team-sub');

      // comparison table nodes
      var cmpSolo = document.getElementById('cmp-solo-price');
      var cmpTeam = document.getElementById('cmp-team-price');

      var ON_STYLE  = 'background:rgba(240,240,220,.1);color:#f7f7f1;box-shadow:0 1px 2px rgba(0,0,0,.3);';
      var OFF_STYLE = 'background:transparent;color:#9a9a8f;';

      var BASE_BTN = 'height:34px;padding:0 15px;border:none;border-radius:999px;font-family:\'Hanken Grotesk\',sans-serif;font-size:13.5px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;transition:all .15s;';

      function apply(mode) {
        billing = mode;
        var annual = mode === 'annual';

        // toggle button styles
        btnMonthly.style.cssText = BASE_BTN + (annual ? OFF_STYLE : ON_STYLE);
        btnAnnual.style.cssText  = BASE_BTN + (annual ? ON_STYLE  : OFF_STYLE);
        btnMonthly.setAttribute('aria-pressed', annual ? 'false' : 'true');
        btnAnnual.setAttribute('aria-pressed',  annual ? 'true'  : 'false');

        // card: Solo
        soloPrice.textContent = annual ? '$60' : '$6';
        soloUnit.textContent  = annual ? '/yr'  : '/mo';
        soloSub.textContent   = annual ? 'billed yearly · 2 months free' : '';

        // card: Team
        teamPrice.textContent = annual ? '$490' : '$49';
        teamUnit.textContent  = annual ? '/yr'   : '/mo';
        teamSub.textContent   = annual ? 'billed yearly · 2 months free' : '';

        // comparison table
        cmpSolo.textContent = annual ? '$60/yr'  : '$6/mo';
        cmpTeam.textContent = annual ? '$490/yr' : '$49/mo';
      }

      btnMonthly.addEventListener('click', function () { apply('monthly'); });
      btnAnnual.addEventListener('click',  function () { apply('annual'); });
    })();
  </script>

</MarketingLayout>
