---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Roadmap · Gatewerk"
  description="What shipped in v1 and what comes next."
>

  <!-- ─── ambient glow ─── -->
  <div style="position:absolute;top:-260px;left:50%;transform:translateX(-50%);width:1100px;height:600px;background:radial-gradient(ellipse at center,rgba(33,181,113,.1),transparent 68%);pointer-events:none;filter:blur(20px);z-index:0;"></div>

  <section style="position:relative;z-index:1;max-width:820px;margin:0 auto;padding:84px 32px 96px;">

    <h1 class="gw-up gw-display" style="font-weight:600;font-size:clamp(34px,5vw,48px);line-height:1.06;letter-spacing:-.03em;color:#f7f7f1;margin:0;">Roadmap</h1>

    <!-- Locked hero copy -->
    <p class="gw-up" style="max-width:600px;margin:22px 0 0;font-size:17px;line-height:1.6;color:#b4b4ac;text-wrap:pretty;">
      v1: the gate, done and structurally honest. Next: the attention layer, notifications that guarantee a human sees it in time.
    </p>

    <!-- After that -->
    <h2 class="gw-display" style="font-size:clamp(22px,3vw,28px);font-weight:600;letter-spacing:-.02em;color:#f7f7f1;margin:56px 0 0;">After that</h2>
    <div style="display:flex;flex-direction:column;border-top:1px solid rgba(240,240,220,.08);margin-top:24px;">

      <div style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <span class="gw-mono" style="font-size:9.5px;font-weight:600;letter-spacing:.07em;padding:3px 7px;border-radius:999px;background:rgba(240,240,220,.06);border:1px solid rgba(240,240,220,.1);color:#8f887c;">Planned</span>
        <span style="font-size:14.5px;color:#cfcfc5;">N-of-M approvals</span> <!-- audit-claims-allow: roadmap planned item, not a current capability claim -->
      </div>

      <div style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <span class="gw-mono" style="font-size:9.5px;font-weight:600;letter-spacing:.07em;padding:3px 7px;border-radius:999px;background:rgba(240,240,220,.06);border:1px solid rgba(240,240,220,.1);color:#8f887c;">Planned</span>
        <span style="font-size:14.5px;color:#cfcfc5;">A curated template catalog</span>
      </div>

      <div style="display:flex;align-items:center;gap:14px;padding:18px 0;border-bottom:1px solid rgba(240,240,220,.08);">
        <span class="gw-mono" style="font-size:9.5px;font-weight:600;letter-spacing:.07em;padding:3px 7px;border-radius:999px;background:rgba(240,240,220,.06);border:1px solid rgba(240,240,220,.1);color:#8f887c;">Planned</span>
        <span style="font-size:14.5px;color:#cfcfc5;">Semantic feedback search</span> <!-- audit-claims-allow: roadmap planned item, not a current capability claim -->
      </div>

    </div>

  </section>

</MarketingLayout>
