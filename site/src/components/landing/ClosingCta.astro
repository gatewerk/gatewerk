---
// Closing CTA — ported from the landing design handoff
// data-cta attributes wire PostHog events in index.astro's unified <script>.
import { QUIET_MODE } from "../../quiet-mode";
---

<section style="position:relative;z-index:1;border-top:1px solid rgba(240,240,220,.06);background:linear-gradient(180deg,#1a1a18,#161614);">
  <div class="gw-section-pad" style="max-width:1200px;margin:0 auto;padding:96px 32px;text-align:center;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#21b571" stroke-width="1.4" style="margin-bottom:24px;">
      <rect x="3" y="10" width="18" height="11" rx="2"/>
      <path d="M7 10V7a5 5 0 0 1 10 0"/>
    </svg>
    <h2 style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(30px,4.4vw,52px);font-weight:600;letter-spacing:-.025em;color:#f7f7f1;margin:0 auto;max-width:30ch;line-height:1.12;text-wrap:balance;">The gate is one endpoint.<br />Install it before you need it.</h2>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:36px;">
      <a href="/docs/quickstart" data-cta="get-started" style="display:inline-flex;align-items:center;gap:9px;height:46px;padding:0 26px;border-radius:12px;background:#21b571;color:#08150e;font-size:15px;font-weight:600;transition:background .15s;text-decoration:none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        Get started
      </a>
      {!QUIET_MODE && (
      <a href="https://app.gatewerk.com/signup" data-cta="try-cloud" style="display:inline-flex;align-items:center;height:46px;padding:0 24px;border-radius:12px;border:1px solid rgba(240,240,220,.14);background:rgba(240,240,220,.02);color:#e4e0d6;font-size:15px;font-weight:500;transition:border-color .15s;text-decoration:none;">Try in the cloud</a>
      )}
    </div>
  </div>
</section>
