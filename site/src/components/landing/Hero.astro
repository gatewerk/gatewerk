---
// Hero section — ported verbatim from the landing design handoff
// CTA wiring: Get started → /docs/quickstart · Try in the cloud → https://app.gatewerk.com/signup
// The "Try in the cloud" CTA is gated by QUIET_MODE (see ../../quiet-mode) and is hidden pre-announcement.
import { QUIET_MODE } from "../../quiet-mode";

// The inbox mock is interactive: pressing a decision button settles the review
// and shows the audit log row and the webhook body that the decision produces.
// The rows below follow the shapes in the docs (Decisions and webhooks, The
// gate, Iteration); the values match what the mock shows on screen.
type Tone = "decided" | "edited";

const escapeHtml = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

// Pretty-prints a value as JSON with keys wrapped for colouring. `tones` maps a
// dotted path to the one meaning-bearing colour that value may carry.
function renderJson(value: unknown, tones: Record<string, Tone> = {}, path = "", depth = 0): string {
  if (value !== null && typeof value === "object") {
    const pad = "  ".repeat(depth + 1);
    const rows = Object.entries(value).map(([key, child]) => {
      const childPath = path ? `${path}.${key}` : key;
      return `${pad}<span class="gw-demo-key">${escapeHtml(JSON.stringify(key))}</span>: ${renderJson(child, tones, childPath, depth + 1)}`;
    });
    return `{\n${rows.join(",\n")}\n${"  ".repeat(depth)}}`;
  }
  const text = escapeHtml(JSON.stringify(value));
  const tone = tones[path];
  return tone ? `<span class="gw-demo-${tone}">${text}</span>` : text;
}

const reviewId = "gw_rev_01j9qk3v";
const reviewer = "alice@team.com";
const settledAt = "2026-11-24T16:32:07.412Z";

// What the agent submitted, and what the reviewer left after editing the budget.
const suggestedValue = {
  daily_budget: 500,
  audience: "Lookalike 2% · US",
  video: "bf_hero_15s.mp4",
  primary_text: "Black Friday: 40% off everything through Sunday...",
  start: "2026-11-27T00:00:00-08:00",
};
const editedValue = {
  daily_budget: 250,
  audience: suggestedValue.audience,
  primary_text: suggestedValue.primary_text,
};

const auditRow = (action: string, details: Record<string, unknown>) => ({
  action,
  actor: "user:usr_7fq2mk",
  resource_type: "review",
  resource_id: reviewId,
  details,
  created_at: settledAt,
  signature: "hmac_sha256:9f41c8...e2",
  prev_signature: "hmac_sha256:c07d51...8a",
});

const decidedWebhook = (decision: string, actionValue: string, actionLabel: string) => ({
  type: "review.decided",
  review_id: reviewId,
  decision,
  decided_at: settledAt,
  was_edited: true,
  suggested_value: suggestedValue,
  approved_value: editedValue,
  edited_payload: editedValue,
  reviewer,
  action_value: actionValue,
  action_label: actionLabel,
  iteration_count: 0,
});

const decidedWebhookTones: Record<string, Tone> = {
  decision: "decided",
  was_edited: "edited",
  "approved_value.daily_budget": "edited",
  "edited_payload.daily_budget": "edited",
};

const outcomes = [
  {
    id: "approved",
    status: "Decided · approved",
    event: "review.decided",
    audit: renderJson(auditRow("review.decided", { decision: "approved", reviewer }), { "details.decision": "decided" }),
    webhook: renderJson(decidedWebhook("approved", "approve", "Launch campaign"), decidedWebhookTones),
  },
  {
    id: "rejected",
    status: "Decided · rejected",
    event: "review.decided",
    audit: renderJson(auditRow("review.decided", { decision: "rejected", reviewer }), { "details.decision": "decided" }),
    webhook: renderJson(decidedWebhook("rejected", "reject", "Don't launch"), decidedWebhookTones),
  },
  {
    // Requesting changes is not a decision: the review waits for the agent to
    // resubmit, so nothing here carries the decided colour.
    id: "changes",
    status: "Waiting on agent to resubmit",
    event: "review.retried",
    audit: renderJson(
      auditRow("review.action_taken", {
        action_id: "request_changes",
        action_label: "Request changes",
        action_kind: "iteration",
        decision_value: null,
        feedback: null,
        edited_payload: editedValue,
        version: 1,
        previous_version: 1,
        trigger_path: "manual",
      }),
      { "details.edited_payload.daily_budget": "edited" },
    ),
    webhook: renderJson({ type: "review.retried", review_id: reviewId, action: "retry" }),
  },
];
