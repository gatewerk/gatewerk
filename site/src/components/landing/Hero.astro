            <button type="button" class="gw-demo-btn gw-demo-btn-decline" data-demo-decide="rejected">Don't launch</button>
          </div>
          <p class="gw-demo-status" role="status" aria-live="polite"><span class="gw-demo-status-text" data-demo-status></span><span class="gw-demo-sr" data-demo-status-note></span></p>
          <button type="button" class="gw-demo-reset" data-demo-reset hidden>Reset</button>
        </div>
      </div>
      <!-- what the decision produced; each outcome stays hidden until its button is pressed -->
      <div class="gw-demo-result">
        {outcomes.map((outcome) => (
          <div class="gw-demo-outcome" data-demo-outcome={outcome.id} data-demo-status-label={outcome.status} hidden>
            <div class="gw-demo-pane">
              <div class="gw-demo-pane-label">audit log</div>
              <pre class="gw-demo-code" tabindex="0" role="region" aria-label="Audit log row" set:html={outcome.audit} />
            </div>
            <div class="gw-demo-pane">
              <div class="gw-demo-pane-label">webhook · {outcome.event}</div>
              <pre class="gw-demo-code" tabindex="0" role="region" aria-label="Webhook body" set:html={outcome.webhook} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-demo]');
    if (!root) return;
    var actions = root.querySelector('[data-demo-actions]');
    var buttons = root.querySelectorAll('[data-demo-decide]');
    var reset = root.querySelector('[data-demo-reset]');
    var status = root.querySelector('[data-demo-status]');
    var note = root.querySelector('[data-demo-status-note]');
    var outcomes = root.querySelectorAll('[data-demo-outcome]');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function show(state) {
      var settled = state !== 'pending';
      var shown = null;
      root.setAttribute('data-demo-state', state);
      actions.hidden = settled;
      reset.hidden = !settled;
      outcomes.forEach(function (outcome) {
        var match = outcome.getAttribute('data-demo-outcome') === state;
        outcome.hidden = !match;
        if (match) shown = outcome;
      });
      status.textContent = shown ? shown.getAttribute('data-demo-status-label') : '';
      note.textContent = shown ? ' Audit log row and webhook body shown.' : '';
      return shown;
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var shown = show(button.getAttribute('data-demo-decide'));
        reset.focus({ preventScroll: true });
        // Bring the result into view only when it fits on screen together with
        // the status line. A taller result would scroll the status away, and
        // it already sits directly under the pressed button.
        var span = shown ? shown.getBoundingClientRect().bottom - status.getBoundingClientRect().top : 0;
        if (shown && span <= window.innerHeight - 96) {
          shown.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        }
      });
    });

    reset.addEventListener('click', function () {
      show('pending');
      buttons[0].focus({ preventScroll: true });
    });
  })();
</script>
