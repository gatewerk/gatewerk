{
  "name": "gatewerk",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @gatewerk/api dev\" \"pnpm --filter @gatewerk/web-next dev\"",
    "build": "pnpm -r build",
    "build:oss": "pnpm -r build",
    "build:cloud": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:cloud": "pnpm -r typecheck",
    "lint": "eslint .",
    "audit:size": "node scripts/audit-size.mjs",
    "audit:surface": "bun scripts/audit-surface.mjs",
    "surface:held": "bun scripts/held-axes.mjs",
    "surface:docs": "bun scripts/generate-surface-docs.mjs",
    "audit:claims": "bash scripts/audit-claims.sh",
    "docker:build:oss": "docker build -f docker/Dockerfile.api -t gatewerk-api:oss .",
    "docker:build:cloud": "docker build -f docker/Dockerfile.api.cloud -t gatewerk-api:cloud .",
    "db:generate": "pnpm --filter @gatewerk/db generate",
    "db:push": "pnpm --filter @gatewerk/db push",
    "db:migrate": "pnpm --filter @gatewerk/db migrate",
    "emails:dev": "pnpm --filter @gatewerk/emails dev",
    "dev:site": "pnpm --filter @gatewerk/site dev",
    "build:site": "pnpm --filter @gatewerk/site build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": "eslint --no-warn-ignored",
    "packages/{shared,db,web-core}/**/*.{ts,tsx}": "eslint --no-warn-ignored"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.12.34": ">=4.13.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "esbuild@<0.25.0": ">=0.25.0",
      "path-to-regexp@>=0.1.0 <0.1.13": "0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "vite@>=6.0.0 <6.4.3": "6.4.3",
      "vite@>=7.0.0 <7.3.2": "7.3.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "lodash@<4.18.0": ">=4.18.1",
      "postcss@<8.5.23": "8.5.26",
      "uuid@<14.0.0": ">=14.0.0",
      "yaml@>=1.0.0 <1.10.3": ">=1.10.3",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "fast-uri@<4.1.2": "4.1.2",
      "ip-address@<10.3.1": "10.4.0",
      "dompurify@<=3.4.12": "3.4.13",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "valibot@<=1.4.1": "1.4.2",
      "body-parser@<1.20.6": "1.20.6",
      "shell-quote@<=1.8.4": "1.9.0",
      "ws@>=8.0.0 <8.21.0": "8.21.3",
      "@babel/core@<=7.29.0": "7.29.6"
    }
  }
}
