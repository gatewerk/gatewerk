# docker/.env.cloud.example — Gatewerk CLOUD deploy (docker-compose.cloud.yml).
# Copy to docker/.env.cloud on the cloud VPS and fill in. NEVER commit the filled copy.
#
# RULES:
# - No inline comments on value lines (everything after "=" becomes the value,
#   including "# ..." — a commented DATABASE_URL breaks psql/API connects).
# - Pass this file at BUILD time too: the web image bakes its VITE_ config from
#   these vars via build args, so `docker compose ... --env-file docker/.env.cloud
#   up -d --build` is mandatory. Building without it ships an app with empty
#   Supabase config ("Something went wrong" screen).

# ── Core (Group A) ────────────────────────────────────────────────
GATEWERK_MODE=cloud

# gatewerk-cloud Supabase pooled (session pooler) connection string
DATABASE_URL=

# 32+ random bytes each
HMAC_SECRET=
JWT_SECRET=
OTP_HMAC_SECRET=

# REQUIRED in cloud mode. Exactly 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`.
# Missing or wrong length = api BootError.
TOTP_ENCRYPTION_KEY=

UI_ORIGIN=https://app.gatewerk.com

# ── Supabase (auth) ───────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Stripe (billing; waitlisted at launch) ────────────────────────
# Real ids only — test-mode OK, but NOT the price_test_/mtr_test_ placeholders
# (boot validator throws on those prefixes and on TEAM == BUSINESS).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_TEAM=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_METER_ID_REVIEWS=

# ── Billing gate (SAFETY-CRITICAL) ────────────────────────────────
# Keep true until billing officially opens. The web build turns this into
# VITE_BILLING_WAITLIST; false/empty with a LIVE Stripe key means real
# checkouts from the UI.
BILLING_WAITLIST=true

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Analytics / errors (optional; safe to leave blank) ────────────
POSTHOG_KEY=
SENTRY_DSN=

# ── CAPTCHA (Turnstile) ───────────────────────────────────────────
# SITE key is public and also baked into the web build (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── Object storage (R2; only if reviews use uploads) ──────────────
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# ── Webhook delivery (optional) ───────────────────────────────────
# Leave blank: the Hookdeck adapter currently 404s against Hookdeck's API and
# Gatewerk falls back to the built-in pg-boss dispatcher.
HOOKDECK_API_KEY=

# ── SMTP (optional; BYO email for self-host parity) ───────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Address a human reads: used for Reply-To and the List-Unsubscribe mailto.
# Leave blank to send with no Reply-To.
EMAIL_CONTACT_ADDRESS=

# ── Web build (baked into the image at build time) ────────────────
# Only VITE_API_URL is read from this file directly; the other VITE_ build args
# (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_TURNSTILE_SITE_KEY,
# VITE_POSTHOG_KEY, VITE_SENTRY_DSN, VITE_BILLING_WAITLIST) are derived by
# docker-compose.cloud.yml from the base vars above — do NOT add VITE_-prefixed
# copies here; they would be ignored.
VITE_API_URL=https://api.gatewerk.com
