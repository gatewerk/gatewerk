# Gatewerk production env file template.
#
# Copy to .env.production alongside docker-compose.prod.yml and fill in the
# real values before deploying. The compose stack reads this file via
# `--env-file docker/.env.production`.
#
# All four variables are required by gatewerk-api at startup (validated by
# config-validation; the API refuses to boot if any are missing or malformed).
# gatewerk-migrate reads only DATABASE_URL.

# Postgres connection string. Production points at the Coolify-managed
# Supabase instance reachable on the `coolify` external network. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:pass@host:5432/dbname

# HMAC signing secret for webhook deliveries and audit-log signature.
# Generate with: openssl rand -hex 32
HMAC_SECRET=replace-with-32-byte-random-hex

# JWT signing secret for session tokens. Independent of HMAC_SECRET so
# rotation policies can differ. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-hex

# Origin allowed by the API CORS policy. The frontend must be served from
# this exact origin (scheme + host + optional port). Default is the public
# app URL; override for staging.
UI_ORIGIN=https://app.gatewerk.com
